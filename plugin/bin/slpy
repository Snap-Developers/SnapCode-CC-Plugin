#!/bin/sh
# SnapCode `slpy` launcher — POSIX sh (works in macOS/Linux shells and Windows git-bash,
# which is what Claude Code's Bash tool uses on every platform).
#
# Why sh and not Python: this file only needs to FORWARD to the real slpy. Writing it in
# Python meant relying on a `python3` shebang, which on Windows resolves to the Microsoft
# Store alias stub (real Python is `python`) — so the launcher couldn't even start. sh has
# no such problem, and forwarding needs no interpreter.
#
# It forwards to the slpy that bootstrap.py installed into the plugin's persistent data
# dir. If slpy isn't there yet (first run / bootstrap hasn't finished), it runs bootstrap
# once (python || python3, to cover both platforms) and then forwards.

# Resolve the plugin data dir the SAME way bootstrap.py does, or the launcher would look
# for slpy somewhere bootstrap didn't install it → endless re-install. Claude Code sets
# CLAUDE_PLUGIN_DATA for the hook but NOT for this launcher, so fall back to the stable
# per-plugin data path (matching bootstrap), not a version-specific dir.
if [ -n "$CLAUDE_PLUGIN_DATA" ]; then
    DATA_DIR="$CLAUDE_PLUGIN_DATA"
elif [ -d "$HOME/.claude/plugins/data" ]; then
    DATA_DIR="$HOME/.claude/plugins/data/snapcode-snapcode"
else
    # last resort (e.g. --plugin-dir dev): plugin_root/.data
    SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
    DATA_DIR="$(dirname -- "$SCRIPT_DIR")/.data"
fi

REAL_SLPY="$DATA_DIR/bin/slpy"
[ -f "$REAL_SLPY.exe" ] && REAL_SLPY="$REAL_SLPY.exe"   # Windows

# Bootstrap once if slpy isn't installed yet.
if [ ! -f "$REAL_SLPY" ]; then
    SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
    BOOTSTRAP="$SCRIPT_DIR/bootstrap.py"
    python "$BOOTSTRAP" 2>/dev/null || python3 "$BOOTSTRAP"
    # re-resolve (bootstrap may have produced slpy or slpy.exe)
    REAL_SLPY="$DATA_DIR/bin/slpy"
    [ -f "$REAL_SLPY.exe" ] && REAL_SLPY="$REAL_SLPY.exe"
fi

if [ ! -f "$REAL_SLPY" ]; then
    echo "[snapcode] slpy is not installed yet and bootstrap did not produce it." >&2
    echo "          expected: $REAL_SLPY" >&2
    exit 1
fi

exec "$REAL_SLPY" "$@"
