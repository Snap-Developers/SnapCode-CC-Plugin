#!/usr/bin/env python3
"""SnapCode `slpy` launcher (cross-platform).

Lives in the plugin's bin/, which Claude Code adds to the Bash tool's PATH while the
plugin is enabled — so a bare `slpy ...` from the agent resolves HERE, ahead of any
older system slpy. This forwards to the real slpy that bootstrap.py installed into
the plugin's persistent data dir (${CLAUDE_PLUGIN_DATA}/bin/slpy).

If the real slpy isn't installed yet (bootstrap hasn't run / failed), it runs the
bootstrap once, then forwards.
"""

import os
import subprocess
import sys
from pathlib import Path

PLUGIN_ROOT = Path(os.environ.get("CLAUDE_PLUGIN_ROOT", Path(__file__).resolve().parent.parent))


def _plugin_data_dir() -> Path:
    """Must match bootstrap.py's resolution exactly, or the launcher looks for slpy in a
    different dir than bootstrap installed it → endless re-install. Claude Code sets
    CLAUDE_PLUGIN_DATA for the hook but NOT for this launcher (invoked via the Bash tool),
    so fall back to the stable per-plugin data path, not the version-specific .data."""
    env = os.environ.get("CLAUDE_PLUGIN_DATA")
    if env:
        return Path(env)
    stable = Path.home() / ".claude" / "plugins" / "data" / "snapcode-snapcode"
    if stable.parent.exists():
        return stable
    return PLUGIN_ROOT / ".data"


PLUGIN_DATA = _plugin_data_dir()

REAL_SLPY = PLUGIN_DATA / "bin" / ("slpy.exe" if os.name == "nt" else "slpy")
BOOTSTRAP = PLUGIN_ROOT / "bin" / "bootstrap.py"


def main() -> int:
    if not REAL_SLPY.exists():
        # Not installed yet — run bootstrap once, then retry.
        subprocess.run([sys.executable, str(BOOTSTRAP)], check=False)
    if not REAL_SLPY.exists():
        sys.stderr.write(
            "[snapcode] slpy is not installed yet and bootstrap did not produce it.\n"
            f"          expected: {REAL_SLPY}\n"
        )
        return 1
    # Forward all args to the real slpy, replacing this process where possible.
    if os.name == "nt":
        return subprocess.call([str(REAL_SLPY), *sys.argv[1:]])
    os.execv(str(REAL_SLPY), [str(REAL_SLPY), *sys.argv[1:]])
    return 0  # unreachable on POSIX


if __name__ == "__main__":
    sys.exit(main())
